{
  "name": "@clerk/internal-mobile-e2e",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.8.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./core/launch": {
      "types": "./dist/src/core/launch.d.mts",
      "import": "./dist/src/core/launch.mjs"
    },
    "./core/*": {
      "types": "./dist/src/core/*.d.ts",
      "import": "./dist/src/core/*.js"
    },
    "./specs/*": {
      "types": "./dist/specs/*.d.ts",
      "import": "./dist/specs/*.js"
    },
    "./testing/*": {
      "types": "./dist/testing/*.d.ts",
      "import": "./dist/testing/*.js"
    }
  },
  "bin": {
    "internal-mobile-e2e-session-agent": "./dist/src/core/remote/session-agent.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@e2e-dev/github": "0.4.0",
    "@e2e-dev/mobile": "0.10.0",
    "ai": "7.0.128",
    "e2e": "0.18.0",
    "agent-device": "0.21.22"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "tsdown": "0.23.1"
  }
}
